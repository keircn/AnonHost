# Server
ANONHOST_URL=http://localhost:1984
ANONHOST_BIND=:1984
ANONHOST_DB_PATH=/app/data/anonhost.db
ANONHOST_UPLOAD_DIR=/app/uploads
ANONHOST_MAX_FILE_SIZE=1073741824
ANONHOST_RATE_LIMIT=5

# Maintenance mode: 1/true/yes/on rejects all uploads with 503 (downloads keep working)
ANONHOST_MAINTENANCE=0

# Docker bind options (for reverse proxy)
ANONHOST_BIND_IP=127.0.0.1
ANONHOST_PORT=1984
ANONHOST_ADMIN_BIND_IP=127.0.0.1
ANONHOST_ADMIN_PORT=1985

# Admin key for protected endpoints
ANONHOST_ADMIN_KEY=

# Internal admin portal (separate port, bind to localhost only)
ANONHOST_ADMIN_BIND=127.0.0.1:1985

# Retroactive retention: files older than this are wiped (storage + DB) hourly
ANONHOST_RETENTION_DAYS=14

# Dedup hash backfill budget per run (hashing downloads each object;
# bounded passes converge over successive runs instead of stalling HTTP)
ANONHOST_DEDUP_MAX_FILES=200
ANONHOST_DEDUP_MAX_BYTES=2147483648

# Cloudflare R2 (optional - omit for local storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
